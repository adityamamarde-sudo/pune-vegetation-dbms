# ==============================================================================
# Pune Vegetation Monitoring & Remote-Sensing Database System
# Local Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      copy .env.example .env   (Windows)
#      cp .env.example .env     (Linux / Mac)
# 2. Update with your local MySQL credentials and optional GEE project ID.
# 3. NEVER commit your actual '.env' file to source control.
# ==============================================================================

# Application Environment (development / production / testing)
APP_ENV=development

# MySQL 8 Database Configuration
# These must match your local MySQL 8 server and MySQL Workbench connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pune_vegetation_db
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password

# Optional: Connection Pool Settings
DB_POOL_SIZE=5
DB_POOL_NAME=pune_veg_pool

# Google Earth Engine (GEE) Settings
# If not yet registered or configured, the app seamlessly runs in Demo Mode.
GEE_PROJECT_ID=your_google_cloud_project_id
GEE_AUTH_MODE=local

# Geospatial Safety Constraints
MAX_STUDY_AREA_SQ_KM=5000.0
DEFAULT_MAP_LAT=18.520430
DEFAULT_MAP_LON=73.856744
DEFAULT_MAP_ZOOM=10
